# =========================
# Database & Redis & Storage
# =========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=echocanvas
POSTGRES_PASSWORD=changeme_local_pg_password
POSTGRES_DB=echocanvas
DATABASE_URL=postgres://echocanvas:changeme_local_pg_password@localhost:5432/echocanvas?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_BUCKET=echocanvas-media
MINIO_USE_SSL=false

# =========================
# Service Ports & Internal Auth
# =========================
GO_GATEWAY_PORT=8080
PY_SIDECAR_URL=http://localhost:8001
GO_GATEWAY_INTERNAL_PROXY_URL=http://localhost:8080/proxy/v1
INTERNAL_AUTH_TOKEN=replace_with_random_internal_token

# =========================
# Upstream Model Providers (Only read by Go AIGC Gateway)
# =========================
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_API_KEY=

LLM_FALLBACK_PROVIDER=openai_compat
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=

VISION_PRIMARY_PROVIDER=siliconflow
VISION_PRIMARY_BASE_URL=https://api.siliconflow.cn/v1
VISION_PRIMARY_MODEL=black-forest-labs/FLUX.1-dev
VISION_PRIMARY_API_KEY=

VISION_FALLBACK_PROVIDER=fal
VISION_FALLBACK_BASE_URL=https://fal.run
VISION_FALLBACK_MODEL=fal-ai/flux/dev
VISION_FALLBACK_API_KEY=

VLM_JUDGE_MODEL=gpt-4o-mini

# =========================
# Observability
# =========================
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
